# Pagina de erro e indices
Options -Indexes
DirectoryIndex index.html

# Compressao de texto
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Cache de estaticos
# CSS e JS: 1 dia. O site usa ?v=NN nos links para furar o cache quando muda,
# mas se alguem esquecer de subir esse numero o prejuizo fica limitado a um dia
# em vez de uma semana. No GitHub Pages esse cache era de 10 minutos.
# HTML nunca em cache.
# A pagina do QR e quem carrega o ?v=N do video. Se ela envelhecer no
# navegador, o leitor pede o .mp4 sem a query e recebe o arquivo antigo,
# que continua guardado por 30 dias - o ?v=N vira inutil.
# Aconteceu em 27/08/2026: os videos novos estavam no ar e o celular
# continuava tocando os velhos.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>
